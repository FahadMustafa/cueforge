<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" ttp:cellResolution="50 33" xml:lang="en" ttp:timeBase="smpte" ttp:frameRate="24">
  <body>
    <div>
      <p begin="00:00:00:00" end="00:00:01:00" tts:textAlign="start">Leading &amp; trailing &lt;tags&gt;</p>
      <p begin="00:00:01:00" end="00:00:02:00"><span tts:fontStyle="italic" tts:textDecoration="underline">italic</span> then <span tts:fontWeight="bold" tts:color="#00AA00">bold</span></p>
      <p begin="00:00:02:00" end="00:00:04:00">Three<br/>separate<br/>rows</p>
      <p begin="00:00:04:00" end="00:00:04:00">Zero-duration cue</p>
    </div>
  </body>
