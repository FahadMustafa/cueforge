<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="" tts:extent="1920px 1080px" ttp:timeBase="media" ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <styling>
      <style xml:id="s0" tts:fontSize="100%" tts:fontFamily="default" tts:color="white" tts:textAlign="center"/>
    </styling>
    <layout>
      <region xml:id="r0" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="00:00:01.000" end="00:00:04.000" style="s0" region="r0">Hello world</p>
      <p begin="00:00:05.000" end="00:00:06.500" style="s0" region="r0">Second<br/>line two</p>
    </div>
  </body>
</tt>
