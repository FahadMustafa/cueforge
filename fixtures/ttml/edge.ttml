  <body>
    <div>
      <p begin="00:00:00.000" end="00:00:01.000" tts:textAlign="start">Leading &amp; trailing &lt;tags&gt;</p>
      <p begin="00:00:01.000" end="00:00:02.000"><span tts:fontStyle="italic" tts:textDecoration="underline">italic</span> then <span tts:fontWeight="bold" tts:color="#00AA00">bold</span></p>
      <p begin="00:00:02.000" end="00:00:04.000">Three<br/>separate<br/>rows</p>
